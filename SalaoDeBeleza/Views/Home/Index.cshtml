@{
    ViewData["Title"] = "Dashboard";
}

<div class="welcome-banner">
    <h5>Olá, @Context.Session.GetString("Username") 👋</h5>
    <p>Este é o painel de gestão do salão. Acompanhe agendamentos, clientes, profissionais, serviços e produtos em um só lugar.</p>
</div>

<div class="row g-3">
    <div class="col-6 col-md-4 col-lg">
        <div class="shortcut-card">
            <div class="shortcut-icon"><i class="fas fa-calendar-alt"></i></div>
            <h6>Agendamentos</h6>
            <p class="text-muted small mb-3">Agenda de atendimentos</p>
            <a asp-controller="Agendamento" asp-action="Index" class="btn btn-sm btn-primary">Acessar</a>
        </div>
    </div>

    <div class="col-6 col-md-4 col-lg">
        <div class="shortcut-card">
            <div class="shortcut-icon"><i class="fas fa-users"></i></div>
            <h6>Clientes</h6>
            <p class="text-muted small mb-3">Base de clientes</p>
            <a asp-controller="Cliente" asp-action="Index" class="btn btn-sm btn-primary">Acessar</a>
        </div>
    </div>

    <div class="col-6 col-md-4 col-lg">
        <div class="shortcut-card">
            <div class="shortcut-icon"><i class="fas fa-user-tie"></i></div>
            <h6>Profissionais</h6>
            <p class="text-muted small mb-3">Gerenciar equipe</p>
            <a asp-controller="Profissional" asp-action="Index" class="btn btn-sm btn-primary">Acessar</a>
        </div>
    </div>

    <div class="col-6 col-md-4 col-lg">
        <div class="shortcut-card">
            <div class="shortcut-icon"><i class="fas fa-cut"></i></div>
            <h6>Serviços</h6>
            <p class="text-muted small mb-3">Catálogo de serviços</p>
            <a asp-controller="Servico" asp-action="Index" class="btn btn-sm btn-primary">Acessar</a>
        </div>
    </div>

    <div class="col-6 col-md-4 col-lg">
        <div class="shortcut-card">
            <div class="shortcut-icon"><i class="fas fa-box"></i></div>
            <h6>Produtos</h6>
            <p class="text-muted small mb-3">Estoque de produtos</p>
            <a asp-controller="Produto" asp-action="Index" class="btn btn-sm btn-primary">Acessar</a>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-circle-info"></i> Como usar o sistema</h5>
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <p class="mb-2"><strong>Profissionais:</strong> cadastre e gerencie a equipe do salão, com foto e especialidade.</p>
                <p class="mb-2"><strong>Clientes:</strong> mantenha um cadastro atualizado de todos os seus clientes.</p>
                <p class="mb-0"><strong>Serviços:</strong> defina o catálogo de serviços oferecidos e seus preços.</p>
            </div>
            <div class="col-md-6">
                <p class="mb-2"><strong>Produtos:</strong> controle o estoque de produtos utilizados e revendidos.</p>
                <p class="mb-0"><strong>Agendamentos:</strong> organize a agenda relacionando cliente, profissional e serviço.</p>
            </div>
        </div>
        <p class="mt-3 mb-0 text-muted small">Use o menu lateral para navegar entre os módulos.</p>
    </div>
</div>
