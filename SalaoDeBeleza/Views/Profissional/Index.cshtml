@model List<SalaoDeBeleza.Models.Profissional>

@{
    ViewData["Title"] = "Profissionais";
}

<div class="page-header">
    <h2><i class="fas fa-user-tie"></i> Profissionais</h2>
    <a asp-action="Criar" class="btn btn-primary"><i class="fas fa-plus"></i> Novo Profissional</a>
</div>

<div class="card">
    <div class="card-body">
        @if (ViewBag.Sucesso != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @ViewBag.Sucesso
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fas fa-user-tie"></i></div>
                <p>Nenhum profissional cadastrado</p>
                <a asp-action="Criar" class="btn btn-primary"><i class="fas fa-plus"></i> Cadastrar Primeiro</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Especialidade</th>
                            <th>CPF</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prof in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(prof.Foto))
                                    {
                                        <img src="~/img/fotos/@prof.Foto" alt="Foto" style="width: 32px; height: 32px; border-radius: 50%; margin-right: 10px; object-fit: cover; vertical-align: middle;" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-user-circle" style="font-size: 1.6rem; margin-right: 10px; color: var(--brand-300); vertical-align: middle;"></i>
                                    }
                                    @prof.Nome
                                </td>
                                <td>@prof.Especialidade</td>
                                <td>@prof.Cpf</td>
                                <td>
                                    @if (prof.Ativo)
                                    {
                                        <span class="badge badge-success"><i class="fas fa-check"></i> Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><i class="fas fa-times"></i> Inativo</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Editar" asp-route-id="@prof.IdProfissional" class="btn btn-sm btn-primary" title="Editar"><i class="fas fa-pen"></i></a>
                                        @if (prof.Ativo)
                                        {
                                            <form asp-action="Excluir" asp-route-id="@prof.IdProfissional" method="post" style="display: inline;" onsubmit="return confirm('Desativar este profissional?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" title="Desativar"><i class="fas fa-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
