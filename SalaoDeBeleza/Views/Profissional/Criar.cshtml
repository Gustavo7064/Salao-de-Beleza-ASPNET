@model SalaoDeBeleza.Models.Profissional

@{
    ViewData["Title"] = "Novo Profissional";
}

<div class="page-header">
    <h2><i class="fas fa-user-plus"></i> Cadastrar Novo Profissional</h2>
</div>

<div class="card">
    <div class="card-body">
        @if (ViewBag.Erro != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle"></i> @ViewBag.Erro
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="Criar" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label">Nome <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Nome" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Especialidade</label>
                        <input type="text" class="form-control" name="Especialidade" placeholder="Ex: Cabeleireira, Manicure, etc" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">CPF</label>
                        <input type="text" class="form-control" name="Cpf" placeholder="000.000.000-00" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Foto</label>
                        <input type="file" class="form-control" name="fotoArquivo" accept="image/*" />
                        <small class="text-muted">Formatos: JPG, PNG, GIF (máx. 5MB)</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-title">Preview da Foto</h6>
                            <div id="photoPreview" style="text-align: center;">
                                <i class="fas fa-image" style="font-size: 3rem; color: var(--brand-300);"></i>
                                <p class="text-muted mt-2 small">Nenhuma foto selecionada</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Salvar</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times"></i> Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.querySelector('input[name="fotoArquivo"]').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(event) {
                document.getElementById('photoPreview').innerHTML = '<img src="' + event.target.result + '" style="max-width: 100%; border-radius: 8px;" />';
            };
            reader.readAsDataURL(file);
        }
    });
</script>
