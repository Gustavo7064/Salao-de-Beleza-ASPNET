@model SalaoDeBeleza.Models.Agendamento

@{
    ViewData["Title"] = "Novo Agendamento";
}

<div class="card">
    <div class="card-header">
        <h5><i class="fas fa-calendar-plus"></i> Agendar Novo Atendimento</h5>
    </div>
    <div class="card-body">
        @if (ViewBag.Erro != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle"></i> @ViewBag.Erro
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="Criar" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Cliente <span class="text-danger">*</span></label>
                        <select class="form-select" name="IdCliente" required>
                            <option value="">Selecione um cliente</option>
                            @if (ViewBag.Clientes != null)
                            {
                                @foreach (var cliente in ViewBag.Clientes)
                                {
                                    <option value="@cliente.IdCliente">@cliente.Nome</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Profissional <span class="text-danger">*</span></label>
                        <select class="form-select" name="IdProfissional" required>
                            <option value="">Selecione um profissional</option>
                            @if (ViewBag.Profissionais != null)
                            {
                                @foreach (var prof in ViewBag.Profissionais)
                                {
                                    <option value="@prof.IdProfissional">@prof.Nome</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Serviço <span class="text-danger">*</span></label>
                        <select class="form-select" name="IdServico" required>
                            <option value="">Selecione um serviço</option>
                            @if (ViewBag.Servicos != null)
                            {
                                @foreach (var servico in ViewBag.Servicos)
                                {
                                    <option value="@servico.IdServico">@servico.Nome - R$ @servico.Preco.ToString("F2")</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Data e Hora <span class="text-danger">*</span></label>
                        <input type="datetime-local" class="form-control" name="DataHora" required />
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Agendar</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times"></i> Cancelar</a>
            </div>
        </form>
    </div>
</div>
