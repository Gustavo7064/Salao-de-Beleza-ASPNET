@model List<SalaoDeBeleza.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5>Lista de Produtos</h5>
            <a asp-action="Criar" class="btn btn-sm btn-primary"><i class="fas fa-plus"></i> Novo Produto</a>
        </div>
    </div>
    <div class="card-body">
        @if (ViewBag.Sucesso != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @ViewBag.Sucesso
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox" style="font-size: 3rem; color: #ccc;"></i>
                <p class="mt-3 text-muted">Nenhum produto cadastrado</p>
                <a asp-action="Criar" class="btn btn-primary"><i class="fas fa-plus"></i> Cadastrar Primeiro</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Marca</th>
                            <th>Preço</th>
                            <th>Estoque</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var produto in Model)
                        {
                            <tr>
                                <td><i class="fas fa-box" style="margin-right: 10px;"></i>@produto.Nome</td>
                                <td>@produto.Marca</td>
                                <td><strong>R$ @produto.Preco.ToString("F2")</strong></td>
                                <td>
                                    @if (produto.Estoque > 0)
                                    {
                                        <span class="badge badge-success">@produto.Estoque un</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Fora de estoque</span>
                                    }
                                </td>
                                <td>
                                    @if (produto.Ativo)
                                    {
                                        <span class="badge badge-success"><i class="fas fa-check"></i> Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><i class="fas fa-times"></i> Inativo</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Editar" asp-route-id="@produto.IdProduto" class="btn btn-sm btn-primary"><i class="fas fa-edit"></i></a>
                                        @if (produto.Ativo)
                                        {
                                            <form asp-action="Excluir" asp-route-id="@produto.IdProduto" method="post" style="display: inline;" onsubmit="return confirm('Desativar este produto?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
