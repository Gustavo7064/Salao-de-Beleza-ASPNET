@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="fas fa-user-tie" style="font-size: 2.5rem; color: #8b5a8f;"></i>
                <h6 class="mt-3 mb-0">Profissionais</h6>
                <p class="text-muted small">Gerenciar equipe</p>
                <a asp-controller="Profissional" asp-action="Index" class="btn btn-sm btn-primary">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="fas fa-users" style="font-size: 2.5rem; color: #8b5a8f;"></i>
                <h6 class="mt-3 mb-0">Clientes</h6>
                <p class="text-muted small">Base de clientes</p>
                <a asp-controller="Cliente" asp-action="Index" class="btn btn-sm btn-primary">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="fas fa-cut" style="font-size: 2.5rem; color: #8b5a8f;"></i>
                <h6 class="mt-3 mb-0">Serviços</h6>
                <p class="text-muted small">Catálogo de serviços</p>
                <a asp-controller="Servico" asp-action="Index" class="btn btn-sm btn-primary">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="fas fa-box" style="font-size: 2.5rem; color: #8b5a8f;"></i>
                <h6 class="mt-3 mb-0">Produtos</h6>
                <p class="text-muted small">Estoque de produtos</p>
                <a asp-controller="Produto" asp-action="Index" class="btn btn-sm btn-primary">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="fas fa-calendar-alt" style="font-size: 2.5rem; color: #8b5a8f;"></i>
                <h6 class="mt-3 mb-0">Agendamentos</h6>
                <p class="text-muted small">Agenda de atendimentos</p>
                <a asp-controller="Agendamento" asp-action="Index" class="btn btn-sm btn-primary">Acessar</a>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><i class="fas fa-info-circle"></i> Bem-vindo ao Sistema</h5>
    </div>
    <div class="card-body">
        <p>Olá, <strong>@Context.Session.GetString("Username")</strong>!</p>
        <p>Este é o sistema de gestão do Salão de Beleza. Aqui você pode gerenciar:</p>
        <ul>
            <li><strong>Profissionais:</strong> Cadastre e gerencie os profissionais do salão</li>
            <li><strong>Clientes:</strong> Mantenha um registro de todos os seus clientes</li>
            <li><strong>Serviços:</strong> Defina os serviços oferecidos e seus preços</li>
            <li><strong>Produtos:</strong> Controle o estoque de produtos</li>
            <li><strong>Agendamentos:</strong> Organize os agendamentos de atendimentos</li>
        </ul>
        <p class="mt-3 text-muted">Use o menu lateral para navegar entre os módulos.</p>
    </div>
</div>
